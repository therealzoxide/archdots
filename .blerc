# -*- mode: sh; mode: sh-bash -*-

source ~/.scripts/bash/gruvbox_dark

##################
# Basic settings #
##################

bleopt input_encoding=UTF-8
bleopt pager=nvim
bleopt editor=nvim
bleopt default_keymap=vi
bleopt exec_errexit_mark=

#############################
# TRANSIENT PROMPT SETTINGS #
#############################

function hexcolor_bold {
	local hex=${1#\#}
	printf '\e[1;38;2;%d;%d;%dm' "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))"
}

local blue=$(hexcolor_bold $blue0)
local reset=$'\e[0m'

bleopt prompt_ps1_final="${blue}>>${reset} "

bleopt prompt_ps1_transient=trim

################
# Vim Settings #
################

function blerc/vim-load-hook {
	((_ble_bash>=40300)) && builtin bind 'set keyseq-timeout 1'

	bleopt prompt_vi_mode_indicator='\e[38;5;109m\q{keymap:vi/mode-indicator}\e[0m'
	bleopt keymap_vi_mode_show=

	bleopt keymap_vi_mode_name_insert=INSERT
	bleopt keymap_vi_mode_name_replace=REPLACE
	bleopt keymap_vi_mode_name_vreplace=VREPLACE
	bleopt keymap_vi_mode_name_visual=VISUSAL
	bleopt keymap_vi_mode_name_select=SELECT
	bleopt keymap_vi_mode_name_linewise=LINE
	bleopt keymap_vi_mode_name_blockwise=BLOCK

	bleopt keymap_vi_mode_string_nmap:=$'\e[1m-- NORMAL --\e[m'
	bleopt keymap_vi_mode_update_prompt=1

	ble-bind -m vi_nmap --cursor 1
	ble-bind -m vi_imap --cursor 5
	ble-bind -m vi_omap --cursor 4
	ble-bind -m vi_xmap --cursor 2
	ble-bind -m vi_smap --cursor 2
	ble-bind -m vi_cmap --cursor 0

}
blehook/eval-after-load keymap_vi blerc/vim-load-hook

##########
# Colors #
##########

ble-face -s region                    fg=$red0
ble-face -s region_insert             fg=$aqua1
ble-face -s region_match              fg=$yellow0
ble-face -s region_target             fg=$blue0
ble-face -s disabled                  fg=$fg3
ble-face -s overwrite_mode            fg=$orange1

ble-face -s syntax_default            none
ble-face -s syntax_command            fg=$purple1
ble-face -s syntax_quoted             fg=$aqua1
ble-face -s syntax_quotation          fg=$aqua1,bold
ble-face -s syntax_escape             fg=$purple0
ble-face -s syntax_expr               fg=$blue0
ble-face -s syntax_error              fg=$red0
ble-face -s syntax_varname            fg=$orange1
ble-face -s syntax_delimiter          bold
ble-face -s syntax_param_expansion    fg=$orange1
ble-face -s syntax_history_expansion  fg=$yellow1
ble-face -s syntax_function_name      fg=$blue0,bold
ble-face -s syntax_comment            fg=$fg4
ble-face -s syntax_glob               fg=$purple0,bold
ble-face -s syntax_brace              fg=$blue1,bold
ble-face -s syntax_tilde              fg=$blue0,bold
ble-face -s syntax_document           fg=$orange0
ble-face -s syntax_document_begin     fg=$orange0,bold

ble-face -s command_builtin_dot       fg=$blue1,bold
ble-face -s command_builtin           fg=$blue0
ble-face -s command_alias             fg=$aqua1
ble-face -s command_function          fg=$blue0
ble-face -s command_file              fg=$blue1
ble-face -s command_keyword           fg=$blue1
ble-face -s command_jobs              fg=$blue1,bold
ble-face -s command_directory         fg=$blue0,underline
ble-face -s command_suffix            fg=$yellow1
ble-face -s command_suffix_new        fg=$blue0

ble-face -s argument_option           fg=$aqua1

ble-face -s filename_directory        fg=$blue1,underline
ble-face -s filename_directory_sticky fg=$yellow1,underline
ble-face -s filename_link             fg=$aqua0,underline
ble-face -s filename_orphan           fg=$red1,underline
ble-face -s filename_setuid           fg=$yellow0,underline
ble-face -s filename_setgid           fg=$yellow0,underline
ble-face -s filename_executable       fg=$blue0,underline
ble-face -s filename_other            underline
ble-face -s filename_socket           fg=$aqua0,underline
ble-face -s filename_pipe             fg=$blue1,underline
ble-face -s filename_character        fg=$orange1,underline
ble-face -s filename_block            fg=$yellow1,underline
ble-face -s filename_warning          fg=$red0,underline
ble-face -s filename_url              fg=$blue1,underline
ble-face -s filename_ls_colors        underline

ble-face -s varname_array             fg=$orange1,bold
ble-face -s varname_empty             fg=$blue1
ble-face -s varname_export            fg=$purple0,bold
ble-face -s varname_expr              fg=$blue0,bold
ble-face -s varname_hash              fg=$aqua1,bold
ble-face -s varname_new               fg=$blue1
ble-face -s varname_number            fg=$yellow1
ble-face -s varname_readonly          fg=$purple0
ble-face -s varname_transform         fg=$aqua1,bold
ble-face -s varname_unset             fg=$orange0

ble-face -s cmdinfo_cd_cdpath         fg=$aqua1

ble-face auto_complete="fg=$yellow0,underline,italic"
ble-face menu_filter_fixed='bold'
ble-face menu_filter_input="fg=$purple1"

