{
	"spacing": 2,
	"modules-left": [
		"niri/workspaces",
		"niri/window"
		],
	"modules-right": [
		"mpris",
		"wireplumber",
		"network",
		"battery",
		"memory",
		"group/system",
		"clock"
	],

	"niri/workspaces": {
		"format": "{icon}"
	},

	"niri/window": {
		"separate-outputs": true,
		"rewrite": {
			"(.*) - Vivaldi": "Vivaldi"
		}
	},

	"mpris": {
		"format": "[ {artist} | {title} ]",
		"title-len": 30
	},

	"wireplumber": {
		"on-click": "foot -e bash -c pulsemixer",
		"format": " {volume}%",
		"tooltip": false
	},

	"network": {
		"tooltip": false,
		"format-wifi": " {bandwidthDownBytes}",
		"format-ethernet": " {bandwidthDownBytes}",
		"format-disconnected": "",
		"on-click": "foot -e bash -c impala"
	},

	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": " {capacity}%",
		"format-charging": " {capacity}%",
		"format-alt": "Remaining: {time}"
	},

	"memory": {
		"format": " {used}",
		"on-click": "foot -e bash -c 'btm'",
		"tooltip": false
	},

	"group/system": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"transition-left-to-right": false
		},
		"modules": [
			"custom/logo",
			"tray",
			"custom/dnd",
			"custom/power",
			"idle_inhibitor"
		]
	},

		// DRAWER START

	"custom/logo": {
		"format": "󰣇",
		"on-click": "~/.scripts/bemenu_run",
		"tooltip": false
	},
	"tray": {
		"spacing": 9,
		"icon-size": 13
	},

	"custom/dnd": {
		"exec": "~/.config/waybar/toggle_dnd.sh",
		"interval": 60,
		"format": "{}",
		"on-click": "~/.config/waybar/toggle_dnd.sh toggle",
		"tooltip": false
	},

	"custom/power": {
		"format": "",
		"on-click": "~/.scripts/power",
		"tooltip": false
	},

	"idle_inhibitor": {
		"tooltip": false,
		"format": "{icon} ",
		"format-icons": {
			"activated": " ",
			"deactivated": " "
		}
	},

		// DRAWER END

	"clock": {
		"interval": 1,
		"format": "{:%T}",
		"format-alt": "{:%b %d, %Y}",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
	}
}
