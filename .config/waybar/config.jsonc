{
	"spacing": 2,
	"modules-left": [
		"sway/workspaces",
		"sway/window"
		],
	"modules-right": [
		"mpris",
		"wireplumber",
		"network",
		"battery",
		"memory",
		"group/system",
		"clock"
	],

	"sway/workspaces": {
		"format": "{icon}",
		"persistent-workspaces": {
			"1": ["DP-1"],
			"2": ["DP-1"],
			"3": ["DP-1"],
			"4": ["DP-1"],
			"5": ["DP-1"],
			"6": ["DP-2"],
			"7": ["DP-2"],
			"8": ["DP-2"],
			"9": ["DP-2"],
			"10": ["DP-2"]
		}
	},

	"sway/window": {
		"separate-outputs": true,
		"rewrite": {
			"(.*) - Vivaldi": "Vivaldi"
		}
	},

	"mpris": {
		"format": "[ {artist} | {title} ]",
		"title-len": 30
	},

	"wireplumber": {
		"on-click": "foot -e bash -c pulsemixer",
		"format": "[ Volume: {volume}% ]",
		"tooltip": false
	},

	"network": {
		"tooltip": false,
		"format-wifi": "[ {bandwidthDownBytes} ]",
		"format-ethernet": "[ {bandwidthDownBytes} ]",
		"format-disconnected": "[ No Internet ]",
		"on-click": "foot -e bash -c impala"
	},

	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "[ Draining: {capacity}% ]",
		"format-full": "[ Full: {capacity}% ]",
		"format-charging": "[ Charging: {capacity}% ]",
		"format-plugged": "[ Charged: {capacity}% ]",
		"format-alt": "[ Remaining: {time} ]"
	},

	"memory": {
		"format": "[ {used} GiB ]",
		"on-click": "foot -e bash -c 'btm'",
		"tooltip": false
	},

	"group/system": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"transition-left-to-right": false
		},
		"modules": [
			"custom/logo",
			"tray",
			"custom/dnd",
			"custom/power",
			"idle_inhibitor"
		]
	},

		// DRAWER START

	"custom/logo": {
		"format": "[ 󰣇 ]",
		"on-click": "~/.scripts/bemenu_run",
		"tooltip": false
	},
	"tray": {
		"spacing": 9,
		"icon-size": 13
	},

	"custom/dnd": {
		"exec": "~/.config/waybar/toggle_dnd.sh",
		"interval": 60,
		"format": "{}",
		"on-click": "~/.config/waybar/toggle_dnd.sh toggle",
		"tooltip": false
	},

	"custom/power": {
		"format": "[ Power ]",
		"on-click": "~/.scripts/bemenu_power",
		"tooltip": false
	},

	"idle_inhibitor": {
		"tooltip": false,
		"format": "{icon} ",
		"format-icons": {
			"activated": "[ No Sleep ]",
			"deactivated": "[ Sleep ]"
		}
	},

		// DRAWER END

	"clock": {
		"interval": 1,
		"format": "[ {:%T} ]",
		"format-alt": "[ {:%b %d, %Y} ]",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
	}
}
